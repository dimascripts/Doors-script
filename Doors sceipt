-- [ ФУНКЦИЯ ПРОВЕРКИ: КРЕСЛО ИЛИ СТУЛ ]
local function isBlacklistedSeat(instance)
    if not instance then return false end
    
    -- Проверка на класс сиденья Roblox
    if instance:IsA("Seat") or instance:IsA("VehicleSeat") then
        return true
    end
    
    -- Проверка по имени объекта и родительских моделей
    local name = instance.Name:lower()
    local parentName = instance.Parent and instance.Parent.Name:lower() or ""
    
    local seatKeywords = {"chair", "seat", "sofa", "couch", "bench", "кресло", "стул", "диван"}
    
    for _, keyword in ipairs(seatKeywords) do
        if name:find(keyword) or parentName:find(keyword) then
            return true
        end
    end
    
    return false
end

-- [ АВТО-СБОР ПРЕДМЕТОВ С ИСКЛЮЧЕНИЕМ КРЕСЕЛ ]
local SafeAutoGrab = Tabs.Items:AddToggle("SafeAutoGrab", {Title = "Безопасный авто-сбор (Без посадки)", Default = true})
task.spawn(function()
    while task.wait(0.2) do
        if Fluent.Toggles.SafeAutoGrab.Value then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local parent = prompt.Parent
                        
                        -- Игнорируем сиденья и стулья
                        if parent and not isBlacklistedSeat(parent) and not isBlacklistedSeat(parent.Parent) then
                            -- Список разрешенных для подбора предметов
                            local itemName = parent.Name
                            local validItems = {
                                "Lighter", "Flashlight", "Lockpick", "Crucifix", 
                                "Vitamins", "Bandage", "Key", "KeyFront", "Battery", "Candle"
                            }
                            
                            local isValid = false
                            for _, item in ipairs(validItems) do
                                if itemName == item or parent:FindFirstChild(item) then
                                    isValid = true
                                    break
                                end
                            end
                            
                            if isValid then
                                local dist = (char.HumanoidRootPart.Position - parent:GetPivot().Position).Magnitude
                                if dist <= prompt.MaxActivationDistance + 5 then
                                    fireproximityprompt(prompt)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- [ АВТО-СБОР МОНЕТ И ЗОЛОТА ]
local AutoGold = Tabs.Items:AddToggle("AutoGold", {Title = "Авто-сбор монет и золота", Default = true})
task.spawn(function()
    while task.wait(0.3) do
        if Fluent.Toggles.AutoGold.Value then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local parent = prompt.Parent
                        if parent and (parent.Name == "GoldPile" or parent.Name == "Gold" or parent.Name == "Coin") then
                            if not isBlacklistedSeat(parent) and not isBlacklistedSeat(parent.Parent) then
                                local dist = (char.HumanoidRootPart.Position - parent:GetPivot().Position).Magnitude
                                if dist <= 15 then
                                    fireproximityprompt(prompt)
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- [ КОМНАТА 100 ]
local Room100Folder = Instance.new("Folder", game.CoreGui)
Room100Folder.Name = "Doors100ESP"

local function highlight100(instance, color)
    if not instance or instance:FindFirstChild("FuseHighlight") then return end
    local hl = Instance.new("Highlight")
    hl.Name = "FuseHighlight"
    hl.FillColor = color
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.3
    hl.Adornee = instance
    hl.Parent = Room100Folder
end

local FuseESPToggle = Tabs.Room100:AddToggle("FuseESPToggle", {Title = "Подсветка предохранителей и щитка", Default = true})
FuseESPToggle:OnChanged(function(Value)
    if not Value then
        Room100Folder:ClearAllChildren()
    else
        task.spawn(function()
            while Fluent.Toggles.FuseESPToggle.Value do
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj.Name == "Fuse" or obj.Name == "LiveFuse" then
                        highlight100(obj, Color3.fromRGB(0, 255, 255))
                    elseif obj.Name == "ElectricCabinet" or obj.Name == "ElevatorBreaker" then
                        highlight100(obj, Color3.fromRGB(0, 255, 0))
                    end
                end
                task.wait(2)
            end
        end)
    end
end)

